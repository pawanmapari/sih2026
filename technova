// ---------- App shell ----------

export default function CropGuardDemo() {
  const [screen, setScreen] = useState("landing"); // landing | roleSelect | app
  const [role, setRole] = useState(null);
  const [view, setView] = useState("farmer"); // farmer | scan | result | expert | official
  const [latestResult, setLatestResult] = useState(null);
  const [requestedExpert, setRequestedExpert] = useState(false);
  const [expertPending, setExpertPending] = useState(false);
  const [confirmedPulse, setConfirmedPulse] = useState(false);

  function pickRole(r) {
    setRole(r);
    setView(r === "expert" ? "expert" : r === "official" ? "official" : "farmer");
    setScreen("app");
  }

  function completeScan() {
    setLatestResult({ condition: MOCK_RESULT.condition, confidence: MOCK_RESULT.confidence, status: "Awaiting expert" });
    setRequestedExpert(false);
    setView("result");
  }

  function requestExpert() {
    setRequestedExpert(true);
    setExpertPending(true);
  }

  function expertConfirm() {
    setExpertPending(false);
    setConfirmedPulse(true);
    setLatestResult((r) => r && { ...r, status: "Confirmed by expert" });
    setView("official");
  }

  if (screen === "landing") return <Landing onEnter={() => setScreen("roleSelect")} />;
  if (screen === "roleSelect") return <RoleSelect onPick={pickRole} />;

  return (
    <div style={{ background: TOKENS.paper, minHeight: "100%" }} className="flex flex-col">
      <TopBar role={role} onExit={() => { setScreen("roleSelect"); }} />

      <div className="flex justify-center gap-1 px-4 pt-3 flex-wrap">
        {[
          { id: "farmer", label: "Farmer dashboard", role: "farmer" },
          { id: "scan", label: "Scan crop", role: "farmer" },
          { id: "expert", label: "Expert review", role: "expert" },
          { id: "official", label: "District map", role: "official" },
        ].map((t) => (
          <button
            key={t.id}
            onClick={() => setView(t.id)}
            className="text-xs px-3 py-1.5 rounded-full font-medium"
            style={{
              background: view === t.id ? TOKENS.forest : "transparent",
              color: view === t.id ? "#fff" : "#6B6752",
              border: view === t.id ? "none" : "1px solid #E4E0D3",
            }}
          >
            {t.label}
            {t.id === "expert" && expertPending && (
              <span className="ml-1.5 inline-block w-1.5 h-1.5 rounded-full" style={{ background: TOKENS.critical }} />
            )}
          </button>
        ))}
      </div>

      <div className="flex-1">
        {view === "farmer" && (
          <FarmerDashboard field={DEMO_FIELDS[0]} onScan={() => setView("scan")} latestResult={latestResult} />
        )}
        {view === "scan" && (
          <Scanner onComplete={completeScan} onBack={() => setView("farmer")} />
        )}
        {view === "result" && (
          <ResultPage onRequestExpert={requestExpert} onBack={() => setView("farmer")} requested={requestedExpert} />
        )}
        {view === "expert" && (
          <ExpertDashboard pending={expertPending} onConfirm={expertConfirm} />
        )}
        {view === "official" && (
          <OfficialDashboard points={OUTBREAK_POINTS} confirmedPulse={confirmedPulse} />
        )}
      </div>
    </div>
  );
}
