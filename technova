// ---------- small building blocks ----------

function Pill({ tone = "leaf", children }) {
  const map = {
    leaf: { bg: "#E7EFE7", fg: TOKENS.forest },
    warn: { bg: "#F7E7D6", fg: "#8A4E14" },
    critical: { bg: "#F5DCDA", fg: "#7A2323" },
    watch: { bg: "#F4EBC9", fg: "#6B5A11" },
    neutral: { bg: "#E7E4D9", fg: "#4A4638" },
  };
  const c = map[tone] || map.neutral;
  return (
    <span
      style={{ background: c.bg, color: c.fg }}
      className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium"
    >
      {children}
    </span>
  );
}

function Card({ children, className = "", style = {} }) {
  return (
    <div
      className={`rounded-2xl border ${className}`}
      style={{ borderColor: "#E4E0D3", background: "#fff", ...style }}
