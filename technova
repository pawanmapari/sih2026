function HotspotMap({ points, confirmedPulse }) {
  return (
    <svg viewBox="0 0 380 300" className="w-full h-auto rounded-xl" style={{ background: "#EFEAD9" }}>
      <defs>
        <pattern id="grid" width="38" height="30" patternUnits="userSpaceOnUse">
          <path d="M 38 0 L 0 0 0 30" fill="none" stroke="#E0DAC6" strokeWidth="1" />
        </pattern>
      </defs>
      <rect width="380" height="300" fill="url(#grid)" />
      {points.map((p) => (
        <g key={p.id}>
          {p.level === "confirmed" && confirmedPulse && (
            <circle cx={p.x} cy={p.y} r="16" fill={LEVEL_COLOR[p.level]} opacity="0.25">
              <animate attributeName="r" values="10;22;10" dur="2s" repeatCount="indefinite" />
              <animate attributeName="opacity" values="0.35;0.05;0.35" dur="2s" repeatCount="indefinite" />
