// ---------- Scanner ----------

function Scanner({ onComplete, onBack }) {
  const [step, setStep] = useState(0);
  const [crop, setCrop] = useState(null);
  const [stage, setStage] = useState(null);
  const [imgReady, setImgReady] = useState(false);
  const [analyzing, setAnalyzing] = useState(false);
  const fileRef = useRef(null);

  const steps = ["Crop", "Stage", "Photo", "Details"];

  function handleFile() {
    setImgReady(true);
  }

  function analyze() {
    setAnalyzing(true);
    setTimeout(() => {
      onComplete({ crop, stage });
    }, 1800);
  }

  return (
    <div className="px-5 md:px-8 py-6 max-w-lg mx-auto pb-24">
      <button onClick={onBack} className="text-sm flex items-center gap-1 mb-4" style={{ color: "#6B6752" }}>
        <ChevronLeft size={15} /> Back
      </button>

      <div className="flex items-center gap-2 mb-6">
        {steps.map((s, i) => (
          <div key={s} className="flex items-center gap-2 flex-1">
            <div
              className="w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium shrink-0"
              style={{
                background: i <= step ? TOKENS.forest : "#E4E0D3",
                color: i <= step ? "#fff" : "#8A8570",
              }}
            >
              {i + 1}
            </div>
            {i < steps.length - 1 && <div className="h-px flex-1" style={{ background: i < step ? TOKENS.forest : "#E4E0D3" }} />}
          </div>
        ))}
      </div>

      {analyzing ? (
        <div className="flex flex-col items-center justify-center py-20">
          <div className="w-14 h-14 rounded-full border-4 animate-spin mb-5" style={{ borderColor: "#E4E0D3", borderTopColor: TOKENS.forest }} />
          <p className="text-sm font-medium" style={{ color: TOKENS.ink }}>Reading symptoms in the image…</p>
          <p className="text-xs mt-1" style={{ color: "#8A8570" }}>Cross-checking against weather and field history</p>
        </div>
      ) : (
        <>
          {step === 0 && (
            <div>
              <h3 className="text-lg mb-4" style={{ fontFamily: "Georgia, serif", color: TOKENS.ink }}>Which crop?</h3>
              <div className="grid grid-cols-2 gap-3">
                {CROPS.map((c) => (
                  <button
                    key={c}
                    onClick={() => setCrop(c)}
                    className="p-3 rounded-xl border text-sm font-medium text-left"
                    style={{
                      borderColor: crop === c ? TOKENS.forest : "#E4E0D3",
                      background: crop === c ? "#EAF0E7" : "#fff",
                      color: TOKENS.ink,
                    }}
                  >
                    {c}
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 1 && (
            <div>
              <h3 className="text-lg mb-4" style={{ fontFamily: "Georgia, serif", color: TOKENS.ink }}>Growth stage?</h3>
              <div className="flex flex-col gap-2">
                {STAGES.map((s) => (
                  <button
                    key={s}
                    onClick={() => setStage(s)}
                    className="p-3 rounded-xl border text-sm font-medium text-left"
                    style={{
                      borderColor: stage === s ? TOKENS.forest : "#E4E0D3",
                      background: stage === s ? "#EAF0E7" : "#fff",
                      color: TOKENS.ink,
                    }}
                  >
                    {s}
                  </button>
                ))}
              </div>
            </div>
          )}

          {step === 2 && (
            <div>
              <h3 className="text-lg mb-4" style={{ fontFamily: "Georgia, serif", color: TOKENS.ink }}>Add a photo</h3>
              <button
                onClick={() => { handleFile(); }}
                className="w-full aspect-[4/3] rounded-xl border-2 border-dashed flex flex-col items-center justify-center gap-2"
                style={{ borderColor: imgReady ? TOKENS.leaf : "#D8D4C6", background: imgReady ? "#EAF0E7" : "#FAF8F2" }}
              >
                {imgReady ? (
                  <>
                    <Leaf size={28} color={TOKENS.leaf} />
                    <p className="text-sm font-medium" style={{ color: TOKENS.forest }}>Sample leaf image attached</p>
                    <p className="text-xs" style={{ color: "#8A8570" }}>Demo photo — tap to change</p>
                  </>
                ) : (
                  <>
                    <Camera size={28} color="#A6A18D" />
                    <p className="text-sm font-medium" style={{ color: "#6B6752" }}>Tap to capture or upload</p>
                  </>
                )}
              </button>
              <input ref={fileRef} type="file" accept="image/*" className="hidden" onChange={handleFile} />
            </div>
          )}

          {step === 3 && (
            <div>
              <h3 className="text-lg mb-2" style={{ fontFamily: "Georgia, serif", color: TOKENS.ink }}>Anything else? (optional)</h3>
              <p className="text-sm mb-4" style={{ color: "#8A8570" }}>Location, recent rainfall and past pest sightings help sharpen the result — the demo fills these from your field profile.</p>
              <Card className="p-4 space-y-2 text-sm">
                <div className="flex justify-between"><span style={{ color: "#8A8570" }}>Location</span><span>Pimpalgaon</span></div>
                <div className="flex justify-between"><span style={{ color: "#8A8570" }}>Recent rainfall</span><span>Moderate, 3 days ago</span></div>
                <div className="flex justify-between"><span style={{ color: "#8A8570" }}>Previous pest sightings</span><span>Pink bollworm (14 days ago)</span></div>
              </Card>
            </div>
          )}

          <div className="flex gap-3 mt-8">
            {step > 0 && (
              <button onClick={() => setStep(step - 1)} className="px-4 py-2.5 rounded-full text-sm font-medium border" style={{ borderColor: "#D8D4C6", color: TOKENS.ink }}>
                Back
              </button>
            )}
            {step < 3 ? (
              <button
                onClick={() => setStep(step + 1)}
                disabled={(step === 0 && !crop) || (step === 1 && !stage) || (step === 2 && !imgReady)}
                className="flex-1 px-4 py-2.5 rounded-full text-sm font-medium flex items-center justify-center gap-2 disabled:opacity-40"
                style={{ background: TOKENS.forest, color: "#fff" }}
              >
                Continue <ChevronRight size={15} />
              </button>
            ) : (
              <button onClick={analyze} className="flex-1 px-4 py-2.5 rounded-full text-sm font-medium" style={{ background: TOKENS.forest, color: "#fff" }}>
                Analyze crop
              </button>
            )}
          </div>
        </>
      )}
    </div>
  );
}

